# AI-MultiCloud-Agent - Configuração de Credenciais
# Copie este arquivo para .env e preencha com suas credenciais reais

# ============================================
# MCP Server Configuration
# ============================================
MCP_SERVER_NAME=AI-MultiCloud-Agent
LOG_LEVEL=INFO
ENVIRONMENT=development

# ============================================
# AWS Credentials
# ============================================
# Opção 1: Access Key ID + Secret Key (não recomendado em produção)
AWS__ACCESS_KEY_ID=AKIA5EXAMPLE5KEYID
AWS__SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG+exampleSecretKey
AWS__REGION=us-east-1

# Opção 2: Usar AWS CLI ~/.aws/credentials (automático se preenchido vazio)
# Nesse caso, deixe as variáveis acima vazias ou comente-as

# ============================================
# Azure Credentials
# ============================================
# Opção 1: Service Principal (recomendado)
AZURE__TENANT_ID=12345678-1234-1234-1234-123456789012
AZURE__CLIENT_ID=87654321-4321-4321-4321-210987654321
AZURE__CLIENT_SECRET=your-client-secret-here
AZURE__SUBSCRIPTION_ID=abcdef12-1234-5678-90ab-cdef12345678

# Opção 2: Usar DefaultAzureCredential (automático se preenchido vazio)
# Nesse caso, deixe as variáveis acima vazias ou comente-as

# ============================================
# Google Cloud Credentials
# ============================================
# Arquivo de chave em JSON (recomendado)
GCP__PROJECT_ID=my-gcp-project-123456
GCP__CREDENTIALS_PATH=~/.gcp/service-account-key.json

# ============================================
# Oracle OCI Credentials
# ============================================
# Configuração OCI CLI padrão
ORACLE__CONFIG_FILE=~/.oci/config
ORACLE__PROFILE=DEFAULT
ORACLE__NAMESPACE=mynamespace
ORACLE__COMPARTMENT_ID=ocid1.compartment.oc1..aaaaaaaabbbbbbbbccccccccddddddddeeeeeeeeffffffffggggggg