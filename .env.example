# ============== Configurações Gerais ==============
MCP_SERVER_NAME=AI-MultiCloud-Agent
LOG_LEVEL=INFO

# ============== AWS ==============
AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AWS_REGION=us-east-1

# ============== Azure ==============
AZURE_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AZURE_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AZURE_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AZURE_SUBSCRIPTION_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AZURE_CONNECTION_STRING="DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net"

# ============== GCP ==============
GCP_PROJECT_ID=seu-projeto-gcp
GCP_CREDENTIALS_PATH=/caminho/para/sua/credencial.json

# ============== Oracle OCI ==============
ORACLE_NAMESPACE=seunamespace
ORACLE_COMPARTMENT_ID=ocid1.compartment.oc1..xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ORACLE_CONFIG_FILE=~/.oci/config
ORACLE_PROFILE=DEFAULT